[Unit]
Description=JARVIS Hermes-Kommandozentrale (Deutsch)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/jarvis-hermes-dashboard-german
ExecStart=/usr/bin/python3 /home/jarvis/jarvis-hermes-dashboard-german/server.py
Environment=HOME=/home/jarvis
Environment=PATH=/home/jarvis/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
