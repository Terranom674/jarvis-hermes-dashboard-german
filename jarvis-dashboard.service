[Unit]
Description=JARVIS Hermes-Kommandozentrale (Deutsch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis-hermes-dashboard-german
ExecStart=/usr/bin/python3 %h/jarvis-hermes-dashboard-german/server.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
