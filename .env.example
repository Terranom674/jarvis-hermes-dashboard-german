# Audio: automatically use the existing Hermes STT/TTS when available.
# Set to browser to disable server speech, or elevenlabs to use ElevenLabs.
JARVIS_AUDIO_BACKEND=auto
# Default Hermes source path from the official Hermes installer.
JARVIS_HERMES_SOURCE=~/.hermes/hermes-agent

# Optional ElevenLabs voice; used only when Hermes audio is unavailable or selected.
# Without either server backend, the dashboard uses browser speech APIs.
# Create a key at https://elevenlabs.io/ and keep this file private.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=0
