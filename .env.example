# JARVIS · deutsche Kommandozentrale
# Standard: vorhandene Hermes-Spracherkennung und Hermes-Stimme verwenden.
# auto: Hermes, falls installiert; sonst kostenlose Browserfunktionen, nie automatisch ElevenLabs.
# hermes: zwingend Hermes verwenden; bei fehlender Umgebung mit Fehler abbrechen.
# browser: deutsche Browser-Spracherkennung und vorhandene deutsche Browserstimme.
# elevenlabs: externer Dienst, nur bei bewusst eingerichtetem API-Schlüssel.
JARVIS_AUDIO_BACKEND=auto

# Quellordner der bestehenden Hermes-Installation (kein neuer Agent).
JARVIS_HERMES_SOURCE=~/.hermes/hermes-agent
# Nur falls Hermes seinen verwalteten Python-Interpreter nicht selbst ermitteln kann:
# JARVIS_HERMES_PYTHON=/absoluter/pfad/zum/hermes-python

# Optional, standardmäßig NICHT benötigt: externer kostenpflichtiger Sprachdienst.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Das bereits vorhandene Hermes-Profil einschließlich Gedächtnis, Skills und Werkzeugen.
HERMES_PROFILE=default
# Wenn der Hermes-Befehl nicht über PATH gefunden wird:
# HERMES_CMD=/home/jarvis/.local/bin/hermes

# Dashboard-Arbeitsverzeichnis, Port und Zeitlimit.
JARVIS_WORKDIR=~
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=0

# Dieses Dashboard erzwingt keine eigenen Hermes-Werkzeugberechtigungen:
# Freigaben werden durch Hermes selbst konfiguriert.
# JARVIS_PERMISSION=normal
